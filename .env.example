# Jcowork Server Configuration
# Copy this to .env and fill in your values

# Server
JCWORK_HOST=0.0.0.0
JCWORK_PORT=3000
JCWORK_DATA_DIR=~/.jcowork/data
JCWORK_JWT_SECRET=change-me-to-a-random-string

# --- SMS Verification-Code Login ---
# Users log in with a phone number plus an SMS code. With no credentials set the
# server falls back to the "dev" channel, which writes each code to the server log
# instead of sending a real message — fine locally, unusable in production.
#
# JCWORK_SMS_PROVIDER: auto (default) | aliyun | dev
#   auto   -> Aliyun when all four credentials below are set, otherwise dev
#   aliyun -> fail fast at startup if any credential is missing
#   dev    -> never send a real message
JCWORK_SMS_PROVIDER=auto
# Aliyun SMS (https://dysmsapi.console.aliyun.com). The template must take a
# single `code` variable, e.g. "您的验证码是${code}，5 分钟内有效。"
JCWORK_SMS_ACCESS_KEY_ID=
JCWORK_SMS_ACCESS_KEY_SECRET=
JCWORK_SMS_SIGN_NAME=
JCWORK_SMS_TEMPLATE_CODE=
# Process-wide ceiling on messages sent per UTC day. This is the only effective
# guard against toll fraud: per-number throttling cannot stop an attacker from
# enumerating the number space and draining the SMS balance.
JCWORK_SMS_DAILY_GLOBAL_CAP=500
# false makes login invite-only: a number with no account is rejected instead of
# being auto-provisioned. Admins then assign numbers from the user management page.
JCWORK_SMS_ALLOW_REGISTER=true

# --- Email Verification Login ---
# Users can also register with an email + password; the address is verified by an
# emailed code, and a forgotten password is reset the same way. With no SMTP
# credentials set the server falls back to the "dev" channel, which writes each
# code to the server log instead of sending a real message.
#
# These variables can also be configured after login (Web: Settings -> Email
# login). A configuration saved there is stored in the database, takes effect
# without a restart, and OVERRIDES this file from the next startup on — this
# file only matters again after "Clear stored configuration" is used.
#
# JCWORK_MAIL_PROVIDER: auto (default) | smtp | dev
#   auto -> SMTP when host/username/password/from are all set, otherwise dev
#   smtp -> fail fast at startup if any credential is missing
#   dev  -> never send a real message
# Note: while provider=auto resolves to the dev fallback, the admin's login is
# guided into a mail setup screen; explicitly setting dev (here or in-app)
# counts as a declared choice and skips that screen.
JCWORK_MAIL_PROVIDER=auto
# Any SMTP provider works (Aliyun DirectMail, Gmail app password, SendGrid, …).
# Port 465 is implicit TLS; 587 (default) and 25 use STARTTLS.
JCWORK_SMTP_HOST=
JCWORK_SMTP_PORT=587
JCWORK_SMTP_USERNAME=
JCWORK_SMTP_PASSWORD=
JCWORK_SMTP_FROM=
# Process-wide ceiling on messages sent per UTC day, independent of the SMS cap.
JCWORK_MAIL_DAILY_GLOBAL_CAP=500
# false disables email registration; existing email accounts can still log in.
JCWORK_MAIL_ALLOW_REGISTER=true

# --- Admin Bootstrap ---
# The seeded `admin` account is created with a published default password. The
# first login cannot be dismissed until a new password is set; from then on the
# self-chosen password is the account's permanent login.
#
# Setting JCWORK_ADMIN_PHONE additionally binds a phone number at startup so the
# admin can also sign in by SMS — it disables nothing.
# JCWORK_ADMIN_PHONE=13800138000
# Special value: unbind the admin's number (recovery when the phone is lost).
# Password login keeps working either way.
# JCWORK_ADMIN_PHONE=clear
#
# Only used when the admin account is first created; an existing account keeps
# its current credentials.
# JCWORK_ADMIN_BOOTSTRAP_PASSWORD=

# Default model (format: provider:model)
# Supported providers: deepseek, qwen, moonshot, openrouter, local
JCWORK_DEFAULT_MODEL=moonshot:kimi-k2.6

# --- LLM Provider API Keys ---
# Only set keys for providers you want to enable.
# Each provider auto-registers when its key is non-empty.

# DeepSeek (https://platform.deepseek.com)
DEEPSEEK_API_KEY=sk-your-deepseek-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Qwen / Tongyi Qianwen (https://dashscope.aliyuncs.com)
QWEN_API_KEY=sk-your-qwen-key
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Moonshot / Kimi (https://platform.moonshot.cn)
# Moonshot provider uses kimi-k2.x models
MOONSHOT_API_KEY=sk-your-moonshot-key
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# OpenRouter (https://openrouter.ai)
# OPENROUTER_API_KEY=sk-your-openrouter-key
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Web search uses built-in Sogou WAP engine (no external service needed)
# SEARXNG_URL is no longer used

# Idle timeout for UserActors (seconds)
JCWORK_IDLE_TIMEOUT=300

# --- Docling Service (PDF parsing & embeddings) ---
# URL of the Docling HTTP service (for Docker, use http://docling:50060)
# For local development, use http://localhost:50060
DOCLING_SERVICE_URL=http://localhost:50060
# Embedding dimension (384 for paraphrase-multilingual-MiniLM-L12-v2)
EMBEDDING_DIM=384
# Embedding model name (used by Docling service)
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# --- Feishu Bot Integration ---
# Feishu configuration is now managed per-user through the web Settings page.
# No environment variables needed. Each user configures their own Feishu app.
