/* 登录页样式（短信验证码 / 邮箱密码 / 管理员引导 / 强制绑定手机号） */
.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-left: 48rpx;
  padding-right: 48rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}

/* 品牌区 */
.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 100rpx;
  margin-bottom: 64rpx;
}

.logo {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  box-shadow: 0 12rpx 40rpx rgba(31, 111, 235, 0.35);
}

.app-name {
  margin-top: 28rpx;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.tagline {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #8b949e;
}

/* 表单卡片 */
.card {
  background: #161b22;
  border: 1rpx solid #30363d;
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
}

/* 登录 / 注册切换 */
.tabs {
  display: flex;
  background: #0d1117;
  border: 1rpx solid #30363d;
  border-radius: 12rpx;
  padding: 6rpx;
  margin-bottom: 36rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 10rpx;
  color: #8b949e;
  font-size: 30rpx;
}

.tab-active {
  background: #1f6feb;
  color: #ffffff;
  font-weight: 600;
}

/* 邮箱模式子页签（登录 / 注册账号 / 找回密码） */
.subtabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 32rpx;
}

.subtab {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 10rpx;
  border: 1rpx solid #30363d;
  color: #8b949e;
  font-size: 26rpx;
}

.subtab-active {
  border-color: #1f6feb;
  background: rgba(31, 111, 235, 0.12);
  color: #58a6ff;
  font-weight: 600;
}

.field {
  margin-bottom: 28rpx;
}

.label {
  font-size: 26rpx;
  color: #8b949e;
  margin-bottom: 12rpx;
}

.hint {
  margin-top: 10rpx;
}

.hint-link {
  color: #58a6ff;
  font-size: 24rpx;
}

/* 绑定态标题与说明 */
.bind-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #e6edf3;
  margin-bottom: 12rpx;
}

.bind-desc {
  font-size: 24rpx;
  color: #8b949e;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

/* 各模式表单下方的一行说明 */
.mode-desc {
  font-size: 22rpx;
  color: #8b949e;
  line-height: 1.6;
  margin-bottom: 28rpx;
}

/* 验证码输入 + 获取按钮 */
.code-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.code-input {
  flex: 1;
  min-width: 0;
}

.code-btn {
  flex-shrink: 0;
  margin: 0;
  padding: 0 24rpx;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 24rpx;
  border-radius: 12rpx;
  background: #21262d;
  border: 1rpx solid #30363d;
  color: #58a6ff;
}

.code-btn[disabled] {
  background: #161b22;
  border-color: #21262d;
  color: #66707a;
}

/* 图形验证码图片：高度与输入框齐平，点击即刷新 */
.captcha-img {
  flex-shrink: 0;
  width: 200rpx;
  height: 76rpx;
  border-radius: 8rpx;
  background: #fff;
}

.logout-row {
  margin-top: 24rpx;
  text-align: center;
}

.error-box {
  margin-bottom: 24rpx;
  background: rgba(248, 81, 73, 0.08);
  border: 1rpx solid rgba(248, 81, 73, 0.4);
  border-radius: 12rpx;
  padding: 18rpx 22rpx;
}

.submit-btn {
  margin-top: 8rpx;
}

/* 页面底部说明 */
.footnote {
  margin-top: auto;
  padding-top: 48rpx;
  font-size: 22rpx;
  color: #66707a;
  line-height: 1.7;
  text-align: center;
}
