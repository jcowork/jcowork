/* 登录 / 注册页样式 */
.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-left: 48rpx;
  padding-right: 48rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}

/* 品牌区 */
.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 100rpx;
  margin-bottom: 64rpx;
}

.logo {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  box-shadow: 0 12rpx 40rpx rgba(31, 111, 235, 0.35);
}

.app-name {
  margin-top: 28rpx;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.tagline {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #8b949e;
}

/* 表单卡片 */
.card {
  background: #161b22;
  border: 1rpx solid #30363d;
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
}

/* 登录 / 注册切换 */
.tabs {
  display: flex;
  background: #0d1117;
  border: 1rpx solid #30363d;
  border-radius: 12rpx;
  padding: 6rpx;
  margin-bottom: 36rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 10rpx;
  color: #8b949e;
  font-size: 30rpx;
}

.tab-active {
  background: #1f6feb;
  color: #ffffff;
  font-weight: 600;
}

.field {
  margin-bottom: 28rpx;
}

.label {
  font-size: 26rpx;
  color: #8b949e;
  margin-bottom: 12rpx;
}

.hint {
  margin-top: 10rpx;
}

.hint-link {
  color: #58a6ff;
  font-size: 24rpx;
}

/* 公开账号开关行 */
.public-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.public-text {
  flex: 1;
  min-width: 0;
}

.public-title {
  font-size: 28rpx;
  color: #e6edf3;
}

.public-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8b949e;
  line-height: 1.5;
}

.error-box {
  margin-bottom: 24rpx;
  background: rgba(248, 81, 73, 0.08);
  border: 1rpx solid rgba(248, 81, 73, 0.4);
  border-radius: 12rpx;
  padding: 18rpx 22rpx;
}

.submit-btn {
  margin-top: 8rpx;
}

/* 页面底部说明 */
.footnote {
  margin-top: auto;
  padding-top: 48rpx;
  font-size: 22rpx;
  color: #66707a;
  line-height: 1.7;
  text-align: center;
}
