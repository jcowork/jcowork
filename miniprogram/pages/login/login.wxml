<!-- 登录：短信验证码 / 邮箱密码（登录·注册·找回密码）/ 管理员密码引导 / 强制绑定手机号 -->
<view class="page" style="padding-top: {{navTotalHeight}}px;">
  <view class="brand">
    <image class="logo" src="/images/logo.png" mode="aspectFit" />
    <view class="app-name">Jcowork</view>
    <view class="tagline">多用户 AI 智能体工作台</view>
  </view>

  <view class="card">
    <view class="tabs" wx:if="{{mode !== 'bind'}}">
      <view class="tab {{mode === 'sms' ? 'tab-active' : ''}}" data-mode="sms" bindtap="switchMode">短信登录</view>
      <view class="tab {{mode === 'email' ? 'tab-active' : ''}}" data-mode="email" bindtap="switchMode">邮箱</view>
      <view class="tab {{mode === 'admin' ? 'tab-active' : ''}}" data-mode="admin" bindtap="switchMode">管理员</view>
    </view>

    <block wx:if="{{mode === 'bind'}}">
      <view class="bind-title">绑定手机号</view>
      <view class="bind-desc">当前账号尚未绑定手机号，绑定后才能继续使用。绑定后该账号只能通过短信验证码登录。</view>
    </block>

    <view class="field" wx:if="{{mode !== 'bind'}}">
      <view class="label">服务器地址</view>
      <input
        class="jc-input"
        value="{{serverUrl}}"
        data-field="serverUrl"
        bindinput="onInput"
        placeholder="https://your-server.com"
        placeholder-class="jc-input-placeholder"
        type="text"
        adjust-position="{{true}}"
      />
      <view class="hint" wx:if="{{defaultServer && serverUrl !== defaultServer}}">
        <text class="hint-link" bindtap="useDefaultServer">恢复为默认服务器地址</text>
      </view>
    </view>

    <block wx:if="{{mode === 'admin'}}">
      <view class="field">
        <view class="label">用户名</view>
        <input
          class="jc-input"
          value="{{username}}"
          data-field="username"
          bindinput="onInput"
          placeholder="请输入用户名"
          placeholder-class="jc-input-placeholder"
          type="text"
        />
      </view>

      <view class="field">
        <view class="label">密码</view>
        <input
          class="jc-input"
          value="{{password}}"
          data-field="password"
          bindinput="onInput"
          placeholder="请输入密码"
          placeholder-class="jc-input-placeholder"
          password="{{true}}"
          confirm-type="done"
          bindconfirm="submit"
        />
      </view>

      <view class="mode-desc">仅供管理员首次登录绑定手机号使用；绑定成功后密码登录将永久关闭</view>
    </block>

    <block wx:if="{{mode === 'email'}}">
      <view class="subtabs">
        <view class="subtab {{emailMode === 'login' ? 'subtab-active' : ''}}" data-emode="login" bindtap="switchEmailMode">登录</view>
        <view class="subtab {{emailMode === 'register' ? 'subtab-active' : ''}}" data-emode="register" bindtap="switchEmailMode">注册账号</view>
        <view class="subtab {{emailMode === 'forgot' ? 'subtab-active' : ''}}" data-emode="forgot" bindtap="switchEmailMode">找回密码</view>
      </view>

      <view class="field">
        <view class="label">邮箱地址</view>
        <input
          class="jc-input"
          value="{{email}}"
          data-field="email"
          bindinput="onInput"
          placeholder="请输入邮箱地址"
          placeholder-class="jc-input-placeholder"
          type="text"
        />
      </view>

      <view class="field" wx:if="{{emailMode !== 'login'}}">
        <view class="label">邮件验证码</view>
        <view class="code-row">
          <input
            class="jc-input code-input"
            value="{{code}}"
            data-field="code"
            bindinput="onInput"
            placeholder="6 位验证码"
            placeholder-class="jc-input-placeholder"
            type="number"
            maxlength="6"
            confirm-type="done"
            bindconfirm="submit"
          />
          <button
            class="code-btn"
            bindtap="sendCode"
            disabled="{{sendingCode || countdown > 0}}"
          >{{countdown > 0 ? countdown + ' 秒后重发' : '获取验证码'}}</button>
        </view>
      </view>

      <view class="field">
        <view class="label">{{emailMode === 'login' ? '密码' : '新密码'}}</view>
        <input
          class="jc-input"
          value="{{password}}"
          data-field="password"
          bindinput="onInput"
          placeholder="{{emailMode === 'login' ? '请输入密码' : '至少 8 位'}}"
          placeholder-class="jc-input-placeholder"
          password="{{true}}"
          confirm-type="done"
          bindconfirm="submit"
        />
      </view>

      <view class="field" wx:if="{{emailMode !== 'login'}}">
        <view class="label">确认密码</view>
        <input
          class="jc-input"
          value="{{confirmPassword}}"
          data-field="confirmPassword"
          bindinput="onInput"
          placeholder="再次输入新密码"
          placeholder-class="jc-input-placeholder"
          password="{{true}}"
          confirm-type="done"
          bindconfirm="submit"
        />
      </view>

      <view class="mode-desc" wx:if="{{emailMode === 'register'}}">验证码将发送到你的邮箱，注册成功后即可登录；密码至少 8 位</view>
      <view class="mode-desc" wx:if="{{emailMode === 'forgot'}}">通过邮箱验证码设置新密码，重置后请使用新密码登录</view>
    </block>

    <block wx:if="{{mode === 'sms' || mode === 'bind'}}">
      <view class="field">
        <view class="label">手机号</view>
        <input
          class="jc-input"
          value="{{phone}}"
          data-field="phone"
          bindinput="onInput"
          placeholder="请输入手机号"
          placeholder-class="jc-input-placeholder"
          type="number"
          maxlength="20"
        />
      </view>

      <view class="field">
        <view class="label">短信验证码</view>
        <view class="code-row">
          <input
            class="jc-input code-input"
            value="{{code}}"
            data-field="code"
            bindinput="onInput"
            placeholder="6 位验证码"
            placeholder-class="jc-input-placeholder"
            type="number"
            maxlength="6"
            confirm-type="done"
            bindconfirm="submit"
          />
          <button
            class="code-btn"
            bindtap="sendCode"
            disabled="{{sendingCode || countdown > 0}}"
          >{{countdown > 0 ? countdown + ' 秒后重发' : '获取验证码'}}</button>
        </view>
      </view>

      <view class="mode-desc" wx:if="{{mode === 'sms'}}">未注册的手机号验证通过后将自动创建账号</view>
    </block>

    <view class="jc-error error-box" wx:if="{{error}}">{{error}}</view>

    <button class="jc-btn submit-btn" bindtap="submit" loading="{{loading}}" disabled="{{loading}}">
      {{mode === 'bind' ? '绑定并继续' : (mode === 'email' && emailMode === 'register') ? '注 册' : (mode === 'email' && emailMode === 'forgot') ? '重置密码' : '登 录'}}
    </button>

    <view class="logout-row" wx:if="{{mode === 'bind'}}">
      <text class="hint-link" bindtap="logout">退出登录</text>
    </view>
  </view>

  <view class="footnote">
    <view>开发者工具调试时，请在「详情 → 本地设置」勾选“不校验合法域名”</view>
    <view>正式发布需要为服务器配置 HTTPS/WSS 域名并加入小程序后台白名单</view>
  </view>
</view>
